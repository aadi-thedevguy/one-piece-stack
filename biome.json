{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/.next",
      "!**/dist",
      "!**/.turbo",
      "!**/dev-dist",
      "!**/.zed",
      "!**/.vscode",
      "!**/routeTree.gen.ts",
      "!**/src-tauri",
      "!**/.nuxt",
      "!bts.jsonc",
      "!**/.expo",
      "!**/.wrangler",
      "!**/.alchemy",
      "!**/.svelte-kit",
      "!**/wrangler.jsonc",
      "!**/.source"
    ]
  },
  "extends": [
    "ultracite",
    "ultracite/biome/core",
    "ultracite/biome/remix"
  ],
  "linter": {
    "rules": {
      "style": {
        "noNestedTernary": "off",
        "useBlockStatements": "off",
        "noMagicNumbers": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "useAwait": "off",
        "noConsole": "off"
      },
      "performance": {
        "noNamespaceImport": "off",
        "noImgElement": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "nursery": {
        "noShadow": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn",
        "noVoid": "warn"
      }
    }
  }
}